    "raw_utf8": "from __future__ import annotations\nimport hashlib\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport subprocess\nimport sys\n\nproduct = Path.cwd()\nout = Path(os.environ[\"TEMP\"]) / \"lca-cxxopts-path-control-20261013\"\nout.mkdir(exist_ok=False)\nspec = importlib.util.spec_from_file_location(\"path_control\", product / \"internal/scripts/acceptance-journeys.py\")\nassert spec and spec.loader\nh = importlib.util.module_from_spec(spec)\nsys.modules[spec.name] = h\nspec.loader.exec_module(h)\nentry = h.corpus.load_manifest()[\"cxxopts\"]\ncached = h.corpus.cached_copy(entry, Path(os.environ[\"LOCALAPPDATA\"]) / \"LocalCodeAgent/qualification-cache\")\nassert cached is not None\nlong = Path(os.environ[\"TEMP\"]) / \"lca-cpu30b-catch2-evidence-diagnostic-20261013/control/hub/X05-catch2-count-repair/ws/clean-source\"\nshort = Path(os.environ[\"TEMP\"]) / \"lca-cxxopts-short-20261013\"\ndata = {\"kind\": \"unchanged-source-windows-path-control\", \"proof\": \"controller/build-system control; no model\", \"upstream_commit\": entry.commit, \"licence\": \"MIT\", \"runs\": []}\nfor label, target in ((\"short\", short), (\"long\", long)):\n    assert not target.exists()\n    repo = h.corpus.disposable_copy(entry, cached, target)\n    commands = h._independent_commands(repo)\n    records = []\n    for index, argv in enumerate(commands):\n        exe = shutil.which(argv[0])\n        assert exe is not None\n        bound = [\"--timeout\", str(h.CTEST_PER_TEST_SECONDS)] if Path(argv[0]).name.lower().startswith(\"ctest\") else []\n        path = out / f\"{label}-{index}.log\"\n        with path.open(\"wb\") as capture:\n            run = subprocess.run([exe, *argv[1:], *bound], cwd=repo, env={**os.environ, **h._INDEPENDENT_ENV}, stdout=capture, stderr=subprocess.STDOUT, timeout=1800, check=False)\n        raw = path.read_bytes()\n        records.append({\"argv\": [exe, *argv[1:], *bound], \"exit_code\": run.returncode, \"bytes\": len(raw), \"sha256\": hashlib.sha256(raw).hexdigest(), \"raw_utf8\": raw.decode(\"utf-8\", errors=\"replace\")})\n        if run.returncode:\n            break\n    head = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=repo).decode().strip()\n    source_diff = subprocess.check_output([\"git\", \"diff\", entry.commit, \"--\", \"include\", \"test\"], cwd=repo).decode()\n    assert not source_diff\n    data[\"runs\"].append({\"label\": label, \"root\": str(repo), \"root_characters\": len(str(repo)), \"head\": head, \"source_test_diff\": source_diff, \"commands\": records})\n    (out / \"receipt.json\").write_text(json.dumps(data, indent=2) + \"\\n\", encoding=\"utf-8\")\n    print(json.dumps({\"label\": label, \"root_characters\": len(str(repo)), \"exits\": [r[\"exit_code\"] for r in records]}), flush=True)\n"
