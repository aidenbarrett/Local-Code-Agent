index 0000000..39c1783
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,25 @@
+# The working tree is the provenance surface.
+#
+# `source_sha256` hashes raw file bytes, deliberately: a hash that normalised
+# line endings before hashing would be a hash of what we decided to look at
+# rather than of what is on disk. The cost of that stronger property is that
+# the checkout has to be deterministic, and by default it is not. Git for
+# Windows ships `core.autocrlf=true`, which rewrites LF to CRLF on checkout, so
+# the identical commit produced a different identity there. Measured:
+#
+#     LF working tree    e16b2f01c4fd4ec4623b4588cffa064fe270ca5ee52b1e290762f8ae91e2566b
+#     same tree as CRLF  6ba842bd27204895d9511a04106a81079c82af846429e638d69995f4d64e657c
+#
+# So the fix belongs here rather than inside the hash. This overrides
+# core.autocrlf for every text file, on every host, and a test asserts that no
+# file in the hashed set has CRLF in the working tree.
+* text=auto eol=lf
+
+# Frozen experimental evidence. `text=auto` already leaves these alone because
+# git detects the NUL bytes, but a dataset is the last thing that should depend
+# on heuristics, so it is stated.
+*.sqlite3 binary
+*.zip binary
+*.png binary
+*.jpg binary
+*.gz binary
diff --git a/benchmark_fixture/generate_project.py b/benchmark_fixture/generate_project.py
index 2360ced..99f0a31 100644
--- a/benchmark_fixture/generate_project.py
+++ b/benchmark_fixture/generate_project.py
@@ -16,6 +16,29 @@ FILES: dict[str, str] = {}
 SCENARIOS: dict[str, dict[str, str]] = {}
 
 
+def _write_text(path: Path, content: str) -> None:
+    """Write one generated file, with LF, on every host.
+
+    Every text write in this module goes through here, deliberately.
+    `write_text` opens in text mode, and text mode on Windows translates each
+    "\\n" into "\\r\\n" on the way out. `benchmark_fixture/cpp_project` is inside
+    the hashed provenance surface, so five unqualified writes rewrote 24 of the
+    76 hashed files as CRLF whenever the generator ran on Windows, and moved
+    `source_sha256` with them. Root `.gitattributes` makes the *checkout*
+    canonical; it cannot make a later write canonical, which is what this does.
+
+    `newline="\\n"` suppresses the translation rather than performing one: a
+    "\\n" in the source string reaches the disk as 0x0A and nothing else is
+    touched. No generated byte changes on Linux, because nothing was being
+    translated here to begin with.
+
+    One funnel is the point. Five call sites each having to remember a keyword
+    is five chances to forget it, and a forgotten one is invisible on the host
+    most of this work happens on.
+    """
+    path.write_text(content, encoding="utf-8", newline="\n")
+
+
 def f(path: str, content: str) -> None:
     FILES[path] = content.lstrip("\n")
 
